{
 "id": "BHV_LivingMannequin",
 "class": "ScpBehaviorDefinition",
 "properties": {
  "root_eval_interval": 0.05,
  "roots": [
   {
    "name": "Freeze",
    "when": [
     {
      "if": "is_observed"
     },
     {
      "if": "provoked",
      "invert": true
     }
    ],
    "states": [
     {
      "name": "HoldStill",
      "initial": true,
      "actions": [
       {
        "do": "stop_movement"
       },
       {
        "do": "freeze_pose"
       },
       {
        "do": "wait",
        "seconds": 3600
       }
      ],
      "transitions": [
       {
        "on": "actions_succeeded",
        "to": "HoldStill"
       }
      ]
     }
    ],
    "hold_seconds": 2
   },
   {
    "name": "Combat",
    "when": [
     {
      "if": "has_target"
     },
     {
      "if": "target_within",
      "distance": 420
     }
    ],
    "hold_seconds": 1.5,
    "nav_policy": "breach",
    "actions": [
     {
      "do": "run_skill",
      "skill": "SKL_Engage",
      "params": {
       "Target": "$Perception.Target",
       "Attack": "$Attack.Tag"
      }
     }
    ]
   },
   {
    "name": "Chase",
    "when": [
     {
      "if": "has_target"
     },
     {
      "if": "time_since_seen",
      "under": 12
     }
    ],
    "hold_seconds": 1,
    "fail_cooldown": 6,
    "nav_policy": "breach",
    "states": [
     {
      "name": "Pursue",
      "initial": true,
      "actions": [
       {
        "do": "move_to",
        "target": "$Perception.TargetLocation",
        "acceptance": 250,
        "speed_profile": "sprint",
        "repath_if_moved": 150
       }
      ],
      "transitions": [
       {
        "on": "event",
        "event": "AI.Event.PathBlocked",
        "to": "ClearPath",
        "conditions": [
         {
          "if": "can_break_furniture",
          "entity": "$Path.BlockingEntity"
         }
        ]
       },
       {
        "on": "actions_succeeded",
        "to": "Pursue"
       },
       {
        "on": "action_failed",
        "to": "Pursue"
       }
      ]
     },
     {
      "name": "ClearPath",
      "actions": [
       {
        "do": "run_skill",
        "skill": "SKL_DestroyEntity",
        "params": {
         "Entity": "$Path.BlockingEntity",
         "Ability": "AI.LivingMannequin.Attack.Regular"
        }
       }
      ],
      "transitions": [
       {
        "on": "actions_succeeded",
        "to": "Pursue"
       },
       {
        "on": "action_failed",
        "to": "Pursue"
       }
      ]
     }
    ]
   },
   {
    "name": "Search",
    "when": [
     {
      "if": "has_target"
     }
    ],
    "actions": [
     {
      "do": "wander",
      "origin": "$Perception.PointOfInterest",
      "ring_min": 100,
      "ring_max": 1000,
      "leg_seconds": 6,
      "pause_seconds": 1.5,
      "speed_profile": "walk_medium"
     }
    ]
   },
   {
    "name": "Search",
    "when": [
     {
      "if": "target_lost_within",
      "seconds": 20
     }
    ]
   },
   {
    "name": "AttackNuisance",
    "when": [
     {
      "if": "has_nuisance",
      "min_damage": 5
     }
    ],
    "nav_policy": "breach",
    "actions": [
     {
      "do": "run_skill",
      "skill": "SKL_DestroyEntity",
      "params": {
       "Entity": "$Perception.Nuisance",
       "Ability": "AI.LivingMannequin.Attack.Regular"
      }
     }
    ]
   },
   {
    "name": "Investigate",
    "when": [
     {
      "if": "heard_noise_within",
      "seconds": 8
     }
    ],
    "actions": [
     {
      "do": "run_skill",
      "skill": "SKL_Investigate",
      "params": {
       "Spot": "$Perception.PointOfInterest"
      }
     }
    ]
   },
   {
    "name": "Freeze"
   }
  ]
 }
}