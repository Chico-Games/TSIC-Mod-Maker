{
  "id": "SKL_DestroyEntity",
  "class": "ScpSkillDefinition",
  "properties": {
    "inputs": {
      "Entity": "actor",
      "Ability": "tag"
    },
    "states": [
      {
        "name": "Approach",
        "initial": true,
        "actions": [
          {
            "do": "move_to",
            "target": "$In.Entity",
            "acceptance_from_actor": "$In.Entity",
            "acceptance": 180,
            "speed_profile": "hurry"
          }
        ],
        "transitions": [
          {
            "on": "tick",
            "conditions": [
              {
                "if": "is_valid",
                "ref": "$In.Entity",
                "negate": true
              }
            ],
            "result": "succeeded"
          },
          {
            "on": "actions_succeeded",
            "to": "Smash"
          },
          {
            "on": "action_failed",
            "result": "failed"
          }
        ]
      },
      {
        "name": "Smash",
        "actions": [
          {
            "do": "activate_ability",
            "ability": "$In.Ability",
            "target": "$In.Entity"
          }
        ],
        "transitions": [
          {
            "on": "tick",
            "conditions": [
              {
                "if": "is_valid",
                "ref": "$In.Entity",
                "negate": true
              }
            ],
            "result": "succeeded"
          },
          {
            "on": "actions_succeeded",
            "to": "Smash"
          },
          {
            "on": "action_failed",
            "result": "failed"
          }
        ]
      }
    ]
  }
}
